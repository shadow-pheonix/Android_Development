<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_card_alt">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Goal" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Lose, maintain, gain, lean bulk, dirty bulk, cut, or set a custom weekly rate." android:textColor="@color/text_secondary" android:textSize="12sp" />
    <Spinner android:id="@+id/profileGoalSpinner" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" android:background="@drawable/bg_input" android:paddingLeft="10dp" android:paddingRight="10dp" />
    <TextView android:id="@+id/profileGoalHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="@color/text_tertiary" android:textSize="11sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Weekly weight change (kg/week)" android:textColor="@color/text_secondary" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <EditText android:id="@+id/profileWeeklyChangeInput" style="@style/Input.Dark" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:hint="e.g. +0.20" android:inputType="numberDecimal|numberSigned" android:singleLine="true" />
        <TextView android:id="@+id/profileUseRecommendedRate" android:layout_width="110dp" android:layout_height="52dp" android:layout_marginLeft="8dp" android:gravity="center" android:background="@drawable/bg_chip" android:text="Recommended" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" android:padding="14dp" android:background="@drawable/bg_card">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Estimated daily calories" android:textColor="@color/text_secondary" android:textSize="12sp" />
        <TextView android:id="@+id/profileCalorieTargetText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="— kcal/day" android:textColor="@color/accent" android:textSize="27sp" android:textStyle="bold" />
        <TextView android:id="@+id/profileEnergyBreakdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
    </LinearLayout>
    <CheckBox android:id="@+id/profileManualCalorieCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:buttonTint="@color/accent" android:text="Override calculated calorie target" android:textColor="@color/text_primary" android:textSize="13sp" />
    <EditText android:id="@+id/profileManualCalorieInput" style="@style/Input.Dark" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="5dp" android:hint="Manual kcal/day" android:inputType="numberDecimal" android:singleLine="true" />
</LinearLayout>
