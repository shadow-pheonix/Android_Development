<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/profileGoalSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:padding="14dp" android:background="@drawable/bg_card_alt" android:visibility="gone">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Calorie goal" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Choose your direction and pace. DietLog calculates a starting target from your saved profile." android:textColor="@color/text_secondary" android:textSize="12sp" />
    <Spinner android:id="@+id/profileGoalSpinner" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:paddingLeft="10dp" android:paddingRight="10dp" />
    <TextView android:id="@+id/profileGoalHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_tertiary" android:textSize="11sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Weekly weight change (kg/week)" android:textColor="@color/text_secondary" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="horizontal">
        <EditText android:id="@+id/profileWeeklyChangeInput" style="@style/Input.Dark" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:hint="e.g. +0.20" android:inputType="numberDecimal|numberSigned" android:singleLine="true" />
        <TextView android:id="@+id/profileUseRecommendedRate" android:layout_width="104dp" android:layout_height="50dp" android:layout_marginLeft="8dp" android:gravity="center" android:background="@drawable/bg_chip" android:text="Recommended" android:textColor="@color/accent" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:orientation="vertical" android:padding="12dp" android:background="@drawable/bg_card">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Preview target" android:textColor="@color/text_secondary" android:textSize="11sp" />
        <TextView android:id="@+id/profileCalorieTargetText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="— kcal/day" android:textColor="@color/accent" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/profileEnergyBreakdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/text_secondary" android:textSize="11sp" />
    </LinearLayout>
    <CheckBox android:id="@+id/profileManualCalorieCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:buttonTint="@color/accent" android:text="Use a manual calorie target" android:textColor="@color/text_primary" android:textSize="13sp" />
    <EditText android:id="@+id/profileManualCalorieInput" style="@style/Input.Dark" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="4dp" android:hint="Manual kcal/day" android:inputType="numberDecimal" android:singleLine="true" />
    <TextView android:id="@+id/profileSaveGoalButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:gravity="center" android:background="@drawable/bg_button_primary" android:text="Save calorie goal" android:textColor="@color/background" android:textSize="14sp" android:textStyle="bold" />
</LinearLayout>
