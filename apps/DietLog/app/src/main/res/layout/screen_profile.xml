<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="20dp" android:paddingTop="16dp" android:paddingRight="20dp" android:paddingBottom="24dp">
        <TextView style="@style/Text.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Profile" android:includeFontPadding="false" />
        <TextView style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Your goals, made personal." android:includeFontPadding="false" />
        <include layout="@layout/section_profile_personal" />
        <include layout="@layout/section_profile_summary" />
        <Button android:id="@+id/profileDietPlan" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="My diet plan and eating preferences" android:textAllCaps="false" android:textColor="@color/accent" android:background="@drawable/bg_chip" android:tag="glass:CONTROL" />
        <include layout="@layout/section_profile_goal" />
        <include layout="@layout/section_profile_nutrition" />
        <include layout="@layout/section_profile_diagnostics" />
    </LinearLayout>
</ScrollView>
