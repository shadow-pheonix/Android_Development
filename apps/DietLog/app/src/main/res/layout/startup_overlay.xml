<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_frosted_scene" android:clickable="true" android:focusable="true"
    android:accessibilityPaneTitle="@string/app_name">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center" android:orientation="vertical" android:gravity="center" android:padding="28dp">
        <ImageView android:id="@+id/startupLogo" android:layout_width="112dp" android:layout_height="112dp"
            android:padding="6dp" android:background="@drawable/bg_card" android:tag="glass:FEATURE"
            android:src="@drawable/ic_fuelnote_foreground" android:importantForAccessibility="no" />
        <TextView android:id="@+id/startupName" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/app_name" android:textColor="@color/text_primary"
            android:textSize="34sp" android:textStyle="bold" android:letterSpacing="0.02" />
        <TextView android:id="@+id/startupTagline" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:gravity="center" android:text="Small steps. Well fueled."
            android:textColor="@color/text_secondary" android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
