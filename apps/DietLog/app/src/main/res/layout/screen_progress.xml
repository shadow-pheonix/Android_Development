<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="20dp" android:paddingTop="18dp" android:paddingRight="20dp" android:paddingBottom="24dp">
        <TextView style="@style/Text.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Progress" android:includeFontPadding="false" />
        <TextView style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Small steps. Lasting progress." android:includeFontPadding="false" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_card_alt">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Weight" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" android:includeFontPadding="false" />
                    <TextView android:id="@+id/progressWeightGoal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Target — kg" android:textColor="@color/text_secondary" android:textSize="12sp" android:includeFontPadding="false" />
                </LinearLayout>
                <TextView android:id="@+id/progressLogWeight" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:paddingLeft="13dp" android:paddingRight="13dp" android:background="@drawable/bg_chip" android:text="+ Log weight" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" android:includeFontPadding="false" style="@style/Action" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="bottom">
                <TextView android:id="@+id/progressCurrentWeight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/text_primary" android:textSize="36sp" android:textStyle="bold" android:includeFontPadding="false" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginBottom="5dp" android:text="kg" android:textColor="@color/text_secondary" android:textSize="14sp" android:includeFontPadding="false" />
            </LinearLayout>
            <TextView android:id="@+id/progressWeightSource" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Profile weight • no progress weight logged yet" android:textColor="@color/text_secondary" android:textSize="12sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/progressWeightEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:gravity="center" android:padding="16dp" android:text="Log your weight to start tracking change. Two logs on different days unlock the trend." android:textColor="@color/text_secondary" android:textSize="12sp" android:includeFontPadding="false" />
            <com.shadowphoenix.dietlog.ui.ProgressTrendView android:id="@+id/progressWeightTrend" android:layout_width="match_parent" android:layout_height="164dp" android:layout_marginTop="8dp" android:visibility="gone" />
            <TextView android:id="@+id/progressWeightPace" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Log weight on at least two days to measure pace." android:textColor="@color/text_secondary" android:textSize="12sp" android:includeFontPadding="false" android:lineSpacingExtra="3dp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Nutrition overview" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" android:includeFontPadding="false" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:weightSum="3">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="5dp" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:background="@drawable/bg_card" android:minHeight="112dp">
                <TextView android:id="@+id/progressAvg7Calories" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold" android:includeFontPadding="false" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="7-day avg" android:textColor="@color/text_secondary" android:textSize="12sp" android:includeFontPadding="false" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="kcal / logged day" android:textColor="@color/text_tertiary" android:textSize="11sp" android:includeFontPadding="false" android:gravity="center" android:lineSpacingExtra="3dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:background="@drawable/bg_card" android:minHeight="112dp">
                <TextView android:id="@+id/progressAvg30Calories" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold" android:includeFontPadding="false" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="30-day avg" android:textColor="@color/text_secondary" android:textSize="12sp" android:includeFontPadding="false" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="kcal / logged day" android:textColor="@color/text_tertiary" android:textSize="11sp" android:includeFontPadding="false" android:gravity="center" android:lineSpacingExtra="3dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="5dp" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:background="@drawable/bg_card" android:minHeight="112dp">
                <TextView android:id="@+id/progressAdherence" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/accent" android:textSize="21sp" android:textStyle="bold" android:includeFontPadding="false" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="On target" android:textColor="@color/text_secondary" android:textSize="12sp" android:includeFontPadding="false" android:gravity="center" />
                <TextView android:id="@+id/progressLoggedDays" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 logged days" android:textColor="@color/text_tertiary" android:textSize="12sp" android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Nutrition trends" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" android:includeFontPadding="false" />
                <TextView android:id="@+id/progressRange7" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:background="@drawable/bg_chip_selected" android:text="7D" android:textColor="@color/black" android:textSize="12sp" android:textStyle="bold" android:includeFontPadding="false" style="@style/Action" android:paddingStart="0dp" android:paddingEnd="0dp" />
                <TextView android:id="@+id/progressRange30" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:gravity="center" android:background="@drawable/bg_chip" android:text="30D" android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="bold" android:includeFontPadding="false" style="@style/Action" android:paddingStart="0dp" android:paddingEnd="0dp" />
            </LinearLayout>
            <TextView android:id="@+id/progressNutritionLowData" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_card_alt" android:padding="16dp" android:text="Log food on at least 3 days to start seeing nutrition trends." android:textColor="@color/text_secondary" android:textSize="12sp" android:visibility="gone" android:includeFontPadding="false" android:lineSpacingExtra="3dp" />
            <TextView android:id="@+id/progressCaloriesChartLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Calories" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" android:includeFontPadding="false" />
            <com.shadowphoenix.dietlog.ui.ProgressTrendView android:id="@+id/progressCaloriesTrend" android:layout_width="match_parent" android:layout_height="170dp" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/progressCaloriesSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="12sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/progressMacroChartLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Macros • % of daily target" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/progressMacroLegend" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="● Protein     ● Carbs     ● Fat" android:textColor="@color/text_secondary" android:textSize="12sp" android:includeFontPadding="false" />
            <com.shadowphoenix.dietlog.ui.ProgressTrendView android:id="@+id/progressMacroTrend" android:layout_width="match_parent" android:layout_height="170dp" android:layout_marginTop="2dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:weightSum="3">
                <TextView android:id="@+id/progressProteinAvg" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="P —" android:textColor="@color/protein" android:textSize="12sp" android:textStyle="bold" android:includeFontPadding="false" />
                <TextView android:id="@+id/progressCarbsAvg" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="C —" android:textColor="@color/carbs" android:textSize="12sp" android:textStyle="bold" android:includeFontPadding="false" />
                <TextView android:id="@+id/progressFatAvg" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="F —" android:textColor="@color/fat" android:textSize="12sp" android:textStyle="bold" android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_card_alt">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Goal adherence • last 30 days" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/progressCalorieAdherence" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Calories —" android:textColor="@color/text_secondary" android:textSize="13sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/progressProteinAdherence" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Protein —" android:textColor="@color/text_secondary" android:textSize="13sp" android:includeFontPadding="false" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Calories: within ±10% of your goal. Protein: at least 90%. Based on completed days with food logged; today is still in progress." android:textColor="@color/text_tertiary" android:textSize="12sp" android:includeFontPadding="false" android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
