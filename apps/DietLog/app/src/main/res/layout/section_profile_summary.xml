<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_card_alt">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Targets" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" android:includeFontPadding="false" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Daily calories and nutrition goals" android:textColor="@color/text_secondary" android:textSize="12sp" android:includeFontPadding="false" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:padding="11dp" android:background="@drawable/bg_card">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Current target" android:textColor="@color/text_secondary" android:textSize="12sp" android:includeFontPadding="false" android:lineSpacingExtra="2dp" />
            <TextView android:id="@+id/profileCurrentTargetSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="2,000 kcal/day" android:textColor="@color/accent" android:textSize="24sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/profileCurrentTargetNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Default until profile is saved" android:textColor="@color/text_tertiary" android:textSize="12sp" android:includeFontPadding="false" android:lineSpacingExtra="2dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="8dp" android:orientation="vertical" android:padding="11dp" android:background="@drawable/bg_card">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Recommended" android:textColor="@color/text_secondary" android:textSize="12sp" android:includeFontPadding="false" android:lineSpacingExtra="2dp" />
            <TextView android:id="@+id/profileRecommendedTargetSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="— kcal/day" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Based on your body and activity" android:textColor="@color/text_tertiary" android:textSize="12sp" android:includeFontPadding="false" android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/profileMacroTargetSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Macros • P 150 g • C 250 g • F 70 g" android:textColor="@color/text_secondary" android:textSize="12sp" android:includeFontPadding="false" android:lineSpacingExtra="4dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <TextView android:id="@+id/profileEditGoalButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:background="@drawable/bg_chip" android:text="Calorie goal" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" android:includeFontPadding="false" android:lineSpacingExtra="2dp" style="@style/Action" android:paddingStart="8dp" android:paddingEnd="8dp" />
        <TextView android:id="@+id/profileEditNutritionButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginLeft="8dp" android:gravity="center" android:background="@drawable/bg_chip" android:text="Nutrition" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" android:includeFontPadding="false" android:lineSpacingExtra="2dp" style="@style/Action" android:paddingStart="8dp" android:paddingEnd="8dp" />
    </LinearLayout>
</LinearLayout>
