<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp" android:background="@drawable/bg_card_alt" android:tag="glass:FEATURE">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="0" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Account &amp; sync" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" android:includeFontPadding="false" />
        <TextView android:id="@+id/profileAccountStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Not signed in • local data stays on this device" android:textColor="@color/text_secondary" android:textSize="12sp" android:lineSpacingExtra="2dp" android:includeFontPadding="false" />
    </LinearLayout>
    <TextView android:id="@+id/profileAccountAction" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginLeft="0dp" android:gravity="center" android:background="@drawable/bg_button_primary" android:text="Log in / sign up" android:textColor="@color/background" android:textSize="12sp" android:textStyle="bold" android:includeFontPadding="false" android:lineSpacingExtra="2dp" style="@style/Action" android:layout_marginTop="12dp" android:tag="glass:ACTION" />
</LinearLayout>
