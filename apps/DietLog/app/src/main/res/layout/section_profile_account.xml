<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="13dp"
    android:background="@drawable/bg_card_alt">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Account &amp; sync"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/profileAccountStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Not signed in • local data stays on this device"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/profileAccountAction"
        android:layout_width="112dp"
        android:layout_height="40dp"
        android:layout_marginLeft="10dp"
        android:gravity="center"
        android:background="@drawable/bg_button_primary"
        android:text="Log in / sign up"
        android:textColor="@color/background"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
