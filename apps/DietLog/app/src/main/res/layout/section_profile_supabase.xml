<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_card_alt"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Supabase" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Optional" android:textColor="@color/text_tertiary" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/supabaseConnectionStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Not signed in" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:id="@+id/supabaseSyncStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Optional account-based backup and multi-device merge." android:textColor="@color/text_secondary" android:textSize="11sp" />
    <TextView android:id="@+id/supabaseConnectButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:background="@drawable/bg_button_primary" android:gravity="center" android:text="Sign in with email code" android:textColor="@color/background" android:textSize="13sp" android:textStyle="bold" />
    <LinearLayout android:id="@+id/supabaseConnectedActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/supabaseSyncNowButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:background="@drawable/bg_chip" android:gravity="center" android:text="Sync now" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/supabaseRestoreButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginLeft="8dp" android:background="@drawable/bg_chip" android:gravity="center" android:text="Restore / merge" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/supabaseDisconnectButton" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="4dp" android:gravity="center" android:text="Sign out" android:textColor="@color/text_secondary" android:textSize="11sp" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Email-code sign-in • refresh token encrypted with Android Keystore." android:textColor="@color/text_tertiary" android:textSize="10sp" />
</LinearLayout>
