<resources>
    <!-- Base style names are explicit because dotted child style names infer these parents. -->
    <style name="Text" />
    <style name="Input" />
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:alertDialogTheme">@style/FrostedDialogTheme</item>
        <item name="android:datePickerDialogTheme">@style/DiaryDatePickerDialog</item>
    </style>

    <style name="DiaryDatePickerDialog" parent="FrostedDialogTheme">
        <item name="android:windowBackground">@drawable/bg_calendar_dialog</item>
        <item name="android:windowMinWidthMajor">@dimen/calendar_dialog_width</item>
        <item name="android:windowMinWidthMinor">@dimen/calendar_dialog_width</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:datePickerStyle">@style/DiaryCalendarDatePicker</item>
        <item name="android:calendarViewStyle">@style/DiaryCalendarView</item>
    </style>

    <style name="DiaryCalendarDatePicker" parent="android:style/Widget.Material.DatePicker">
        <item name="android:datePickerMode">calendar</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:headerBackground">@android:color/transparent</item>
        <item name="android:headerMonthTextAppearance">@style/DiaryCalendarHeaderText</item>
        <item name="android:calendarTextColor">@color/text_primary</item>
    </style>

    <style name="DiaryCalendarView" parent="android:style/Widget.Material.CalendarView">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:dateTextAppearance">@style/DiaryCalendarDayText</item>
        <item name="android:weekDayTextAppearance">@style/DiaryCalendarWeekText</item>
    </style>

    <style name="DiaryCalendarHeaderText" parent="android:style/TextAppearance.Material.Headline">
        <item name="android:textColor">@color/calendar_header_text</item>
        <item name="android:textSize">@dimen/calendar_max_text_size</item>
    </style>

    <style name="DiaryCalendarDayText" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">@color/calendar_day_text</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="DiaryCalendarWeekText" parent="android:style/TextAppearance.Material.Caption">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Text.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Section">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Body">
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="FrostedSpinner" parent="android:style/Widget.Material.Spinner">
        <item name="android:spinnerMode">dropdown</item>
        <item name="android:popupTheme">@style/FrostedDropdownTheme</item>
        <item name="android:popupBackground">@drawable/bg_dropdown_popup</item>
        <item name="android:popupElevation">8dp</item>
        <item name="android:dropDownWidth">match_parent</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:tag">glass:INPUT</item>
    </style>

    <style name="FrostedDropdownTheme" parent="AppTheme">
        <item name="android:dropDownListViewStyle">@style/FrostedDropdownList</item>
    </style>

    <style name="FrostedDropdownList" parent="android:style/Widget.Material.ListView.DropDown">
        <item name="android:listSelector">@drawable/bg_dropdown_selected</item>
        <item name="android:divider">@android:color/transparent</item>
        <item name="android:dividerHeight">4dp</item>
    </style>

    <style name="Input.Dark">
        <item name="android:tag">glass:INPUT</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="Action" parent="Text.Body">
        <item name="android:tag">glass:CONTROL</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="FrostedDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_card</item>
        <item name="android:colorBackgroundFloating">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowAnimationStyle">@style/FrostedDialogMotion</item>
        <item name="android:backgroundDimAmount">0.45</item>
    </style>
    <style name="FrostedDialogMotion" parent="android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/frosted_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/frosted_dialog_exit</item>
    </style>
</resources>
